---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  active: 'certificates' | 'resume';
}
const { title, description, active } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Dranreb Wen Balangbang</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="documents-header">
      <a class="back-link" href="/#about"><span aria-hidden="true">←</span> Back to portfolio</a>
      <nav aria-label="Documents">
        <a href="/certificates/" aria-current={active === 'certificates' ? 'page' : undefined}>Certificates</a>
        <a href="/resume/" aria-current={active === 'resume' ? 'page' : undefined}>Resume</a>
      </nav>
    </header>
    <main id="main-content" tabindex="-1">
      <div class="page-heading">
        <h1>{title}</h1>
      </div>
      <slot />
    </main>
  </body>
</html>

<style>
  .documents-header, main { width: min(100%, 1200px); margin-inline: auto; padding-inline: var(--page-gutter); }
  .documents-header { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 96px; }
  .back-link { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--color-text-secondary); text-decoration: none; font-size: 14px; }
  .back-link:hover { color: var(--color-text); }
  nav { display: flex; gap: 4px; padding: 4px; border: 1px solid var(--color-border); border-radius: var(--radius-pill); }
  nav a { display: grid; place-items: center; min-height: 44px; padding: 10px 20px; border-radius: var(--radius-pill); color: var(--color-text-secondary); font-size: 13px; text-decoration: none; }
  nav a:hover { background: var(--color-pill); color: var(--color-text); }
  nav a[aria-current='page'] { background: var(--color-inverse); color: var(--color-on-inverse); }
  main { padding-bottom: 96px; }
  .page-heading { padding-block: clamp(40px, 7vw, 88px) 44px; }
  h1 { margin: 0; font-family: var(--font-display); font-size: clamp(30px, 6vw, 64px); font-weight: 400; line-height: 1.15; overflow-wrap: anywhere; }
  @media (max-width: 600px) {
    .documents-header { align-items: flex-start; flex-direction: column; gap: 8px; padding-top: 16px; }
    nav { align-self: stretch; }
    nav a { flex: 1; }
    .page-heading { padding-block: 40px 32px; }
    main { padding-bottom: 64px; }
  }
</style>
