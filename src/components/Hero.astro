---
import ButtonCharacter from './ButtonCharacter.astro';
import HeroShapes from './HeroShapes.astro';
import HeroPortrait from './HeroPortrait.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-stage">
  <div class="hero-content">
    <h1 id="hero-title" class="animated-headline" aria-label="Hello, I’m Dranreb Wen Balangbang"><span class="hero-greeting">Hello, I’m</span><br />Dranreb Wen<br />Balangbang</h1>
    <p class="hero-role">
      <span class="sr-only">I'm a graphic designer, motion graphics designer, UI/UX designer, and full-stack developer.</span>
      <span class="role-copy" aria-hidden="true">I'M A <span class="role-title">GRAPHIC DESIGNER</span></span>
    </p>
    <div class="hero-action" data-character-stage data-ready="loading" data-mode="idle" data-direction="right" data-strikes="0">
      <div class="button-shell">
        <ButtonCharacter />
        <a href="#graphic-design" class="work-button" data-character-button>
          <span class="work-button-surface">VIEW MY WORK</span>
        </a>
      </div>
      <p class="load-status sr-only" role="status">Loading animation…</p>
    </div>
  </div>
  <HeroPortrait />
  <HeroShapes />
  </div>
  <div class="hero-shade" aria-hidden="true"></div>
</section>

<style>
  .hero {
    overflow: clip;
    scroll-margin-top: var(--header-height);
    position: relative;
  }

  .hero-stage {
    position: relative;
    max-width: 1440px;
    margin-inline: auto;
    min-height: 760px;
    padding: 80px max(var(--page-gutter), 7.5vw) 120px;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: 36px;
    text-align: left;
    transform-origin: 50% 0;
  }

  .hero-shade { position: absolute; inset: 0; z-index: 5; pointer-events: none; background: #000; opacity: 0; }

  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    :global(.intro-stack[data-stacking]) .hero { position: sticky; top: var(--hero-sticky-top); }
  }

  .hero-content {
    position: relative;
    z-index: 3;
    width: min(100%, 800px);
  }


  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(42px, 5.3vw, 76px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .hero-greeting { --color-text: #595959; color: var(--color-text); }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-headline-entrance='pending']) h1 {
      opacity: 0;
    }
  }

  .hero-role {
    margin: 16px 0 0;
    font-family: var(--font-body);
    font-size: clamp(14px, 1.25vw, 18px);
    font-weight: 500;
    letter-spacing: 0.09em;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }


  .role-copy {
    display: block;
    position: relative;
    white-space: nowrap;
    overflow: clip;
  }

  .role-copy.has-role-letters {
    color: transparent;
  }

  .role-copy :global(.role-measure) {
    position: absolute;
    inset: 0;
    visibility: hidden;
    white-space: pre;
  }

  .role-copy :global(.role-letter) {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    overflow: clip;
    text-align: left;
    color: var(--color-text-secondary);
  }

  .role-copy :global(.role-glyph) {
    display: block;
  }

  .hero-action {
    width: 304px;
    max-width: 100%;
    margin: 104px 0 0;
  }

  .button-shell {
    position: relative;
  }

  .work-button {
    display: block;
    text-decoration: none;
    width: 100%;
    min-height: 70px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-on-inverse);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: .01em;
  }

  .work-button-surface {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    min-height: inherit;
    padding: 16px 24px;
    border: 1px solid var(--color-inverse);
    border-radius: 0;
    background: var(--color-inverse);
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .work-button:hover .work-button-surface {
      border-color: var(--color-cta-hover);
      background: var(--color-cta-hover);
    }
  }

  .work-button:focus-visible .work-button-surface {
    border-color: var(--color-cta-hover);
    background: var(--color-cta-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-button-surface {
      transition: none;
    }
  }

  @media (max-width: 767px) {
    .hero-stage {
      min-height: 0;
      padding: 48px 24px 48px;
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      text-align: center;
    }


    h1 {
      font-size: clamp(28px, 8.7vw, 44px);
    }

    .hero-role {
      margin-top: 36px;
      font-size: clamp(10px, 2.8vw, 13px);
    }


    .hero-action {
      width: 182px;
      margin: 88px auto 0;
    }

    .work-button {
      min-height: 54px;
      font-size: 13px;
    }

    .work-button-surface {
      padding: 15px 24px;
    }
  }
</style>
