---
import BackgroundGrid from './BackgroundGrid.astro';
import HeroShapes from './HeroShapes.astro';
import ButtonCharacter from './ButtonCharacter.astro';
const email = 'dranrebwen2505@gmail.com';
---

<section id="contact" class="contact-section" aria-labelledby="contact-title" tabindex="-1">
  <div class="contact-panel">
    <BackgroundGrid id="contact-grid" local />
    <p class="contact-intro">Let’s get together.</p>
    <h2 id="contact-title">Have a project in mind? I’d love to hear about it.</h2>
    <div class="contact-action" data-character-stage data-ready="loading" data-mode="idle" data-direction="right" data-strikes="0">
      <div class="button-shell">
        <ButtonCharacter />
        <a class="contact-cta" href={`mailto:${email}`} data-character-button data-contact-open aria-haspopup="dialog" aria-controls="contact-dialog">GET IN TOUCH</a>
      </div>
      <p class="load-status sr-only" role="status">Loading animation…</p>
    </div>
    <HeroShapes contact />
  </div>
</section>

<dialog id="contact-dialog" class="contact-dialog" aria-labelledby="contact-dialog-title" aria-describedby="contact-dialog-description">
  <div class="contact-dialog-header">
    <p class="contact-dialog-eyebrow">Let’s work together</p>
    <button class="contact-close" type="button" aria-label="Close contact" autofocus><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
  </div>
  <h2 id="contact-dialog-title">Get in touch.</h2>
  <p id="contact-dialog-description">Have an idea or a project in mind? Let’s talk.</p>
  <form class="contact-form" action="https://api.web3forms.com/submit" method="post">
    <input type="hidden" name="access_key" value="d82fa395-0d5f-4f0c-a382-03d7687c9c3b" />
    <input type="hidden" name="subject" value="New message from Dranweb portfolio" />
    <input type="hidden" name="from_name" value="Dranweb portfolio" />
    <div hidden><label>Leave this empty<input type="checkbox" name="botcheck" tabindex="-1" /></label></div>
    <div class="contact-form-row">
      <div class="contact-field">
        <label for="contact-name">Name</label>
        <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="100" required />
      </div>
      <div class="contact-field">
        <label for="contact-email">Email</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" autocapitalize="off" spellcheck="false" required />
      </div>
    </div>
    <div class="contact-field">
      <label for="contact-message">Message</label>
      <textarea id="contact-message" name="message" rows="5" maxlength="5000" required></textarea>
    </div>
    <button class="contact-send" type="submit">Send message <span aria-hidden="true">↗</span></button>
    <p class="contact-form-status" role="status" aria-live="polite" aria-atomic="true"></p>
  </form>
  <p class="contact-methods-divider">or</p>
  <div class="contact-methods">
    <a class="contact-method" href={`mailto:${email}`}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></svg>
      <span class="contact-method-copy"><span class="contact-method-label">Email me</span><span class="contact-method-detail">{email}</span></span>
      <span aria-hidden="true">↗</span>
    </a>
    <a class="contact-method" href="https://github.com/dranrebwen424" target="_blank" rel="noopener noreferrer">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m8 6-6 6 6 6m8-12 6 6-6 6m-3-15-2 18" /></svg>
      <span class="contact-method-copy"><span class="contact-method-label">GitHub</span><span class="contact-method-detail">dranrebwen424 <span class="sr-only">(opens in a new tab)</span></span></span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</dialog>

<script>
  import '../scripts/contact';
  import { startBackgroundGrid } from '../scripts/background-grid';

  const startDecorations = async () => {
    const grid = document.querySelector<HTMLElement>('.contact-grid')!;
    const shapes = document.querySelector<HTMLElement>('.contact-shapes')!;
    startBackgroundGrid(false, grid);
    try {
      const { startShapes } = await import('../scripts/hero-shapes');
      startShapes(shapes);
    } catch {
      shapes.dataset.state = 'fallback';
    }
  };
  void startDecorations();
  window.addEventListener('pageshow', event => { if (event.persisted) void startDecorations(); });
</script>

<style>
  .contact-section { padding: 0; scroll-margin-top: 100px; }
  .contact-section:focus { outline: none; }
  .contact-panel { position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; min-height: clamp(540px, 45vw, 650px); margin-inline: auto; padding: 64px 24px; border-radius: 0; background: var(--color-inverse); color: var(--color-on-inverse); text-align: center; }
  .contact-intro, .contact-panel h2, .contact-action { position: relative; z-index: 3; }
  .contact-action { margin-top: 112px; }
  .button-shell { position: relative; }
  .contact-intro { margin: 0; font-size: clamp(18px, 1.5908vw, 22.907px); font-weight: 500; line-height: 1; letter-spacing: .05em; }
  .contact-panel h2 { max-width: 1060px; margin: 40px 0 0; font-family: var(--font-display); font-size: clamp(32px, 4.3vw, 62px); font-weight: 400; line-height: 1.15; letter-spacing: 0; text-wrap: balance; }
  .contact-cta { display: inline-flex; align-items: center; justify-content: center; gap: 28px; min-width: clamp(220px, 20.8333vw, 300px); min-height: clamp(54px, 5vw, 70px); padding: 16px 24px; border-radius: var(--radius-pill); background: var(--color-background); color: var(--color-text); font-size: 16px; font-weight: 500; text-decoration: none; transition: translate 420ms var(--ease-out), background-color 220ms ease; }
  .contact-cta span { transition: transform 300ms var(--ease-out); }
  .contact-cta:is(:hover, :focus-visible) span { transform: translate(3px, -3px); }
  .contact-cta:focus-visible { outline-color: var(--color-on-inverse); translate: 0 -3px; }
  .contact-dialog { position: fixed; inset: 0; width: min(680px, calc(100vw - 48px)); max-width: none; max-height: calc(100dvh - 48px); margin: auto; padding: 24px 32px 32px; overflow: auto; overscroll-behavior: contain; border: 1px solid #595959; border-radius: 0; background: #1f1f1f; color: #fff; }
  .contact-dialog :is(a, button, input, textarea):focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  .contact-dialog::backdrop { background: var(--color-motion-backdrop); }
  .contact-dialog[open] { animation: contact-dialog-in 240ms ease-out; }
  .contact-dialog-header { position: sticky; top: 0; z-index: 3; display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 20px; background: #1f1f1f; }
  .contact-dialog-eyebrow { margin: 0; color: #c8c8c8; font-size: 12px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; }
  .contact-close { display: grid; place-items: center; flex-shrink: 0; width: 44px; height: 44px; padding: 0; border: 1px solid #777; border-radius: 0; background: transparent; }
  .contact-dialog h2 { margin: 0; font: 400 clamp(30px, 5vw, 42px)/1.15 var(--font-display); }
  #contact-dialog-description { margin: 12px 0 32px; color: #c8c8c8; font-size: 16px; line-height: 1.5; }
  .contact-form { display: grid; gap: 28px; }
  .contact-form-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; }
  .contact-field { position: relative; min-width: 0; }
  .contact-field label { position: absolute; z-index: 1; top: 0; left: 20px; translate: 0 -50%; padding-inline: 8px; background: #1f1f1f; color: #fff; font-size: 18px; line-height: 1.2; }
  .contact-field :is(input, textarea) { display: block; width: 100%; min-height: 72px; padding: 22px 20px 16px; border: 1px solid #ddd; border-radius: 0; background: transparent; color: #fff; font: 400 16px/1.5 var(--font-body); scroll-margin-block: 72px 24px; }
  .contact-field textarea { min-height: 152px; resize: vertical; }
  .contact-field :is(input, textarea):focus-visible { border-color: #fff; outline-offset: 3px; }
  .contact-send { display: flex; align-items: center; justify-content: center; gap: 14px; min-height: 56px; padding: 16px 24px; border: 1px solid #fff; border-radius: 0; background: #fff; color: #111; font-size: 15px; font-weight: 700; }
  .contact-send:disabled { cursor: wait; opacity: .65; }
  .contact-field :disabled { opacity: .65; }
  .contact-form-status { margin: -12px 0 0; color: #e5e5e5; font-size: 14px; line-height: 1.5; }
  .contact-form-status:empty { display: none; }
  .contact-form-status[data-state='error'] { color: #ffc1bd; }
  .contact-methods-divider { display: flex; align-items: center; gap: 16px; margin: 24px 0; color: #c8c8c8; font-size: 14px; }
  .contact-methods-divider::before, .contact-methods-divider::after { content: ''; flex: 1; height: 1px; background: #595959; }
  .contact-methods { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .contact-method { display: flex; align-items: center; gap: 12px; min-width: 0; min-height: 88px; padding: 16px; border: 1px solid #777; border-radius: 0; color: inherit; text-decoration: none; transition: background-color 180ms ease; }
  .contact-method > svg { flex-shrink: 0; }
  .contact-method-copy { display: grid; flex: 1; min-width: 0; gap: 4px; }
  .contact-method-label { font-size: 15px; font-weight: 700; }
  .contact-method-detail { color: #c8c8c8; font-size: 13px; line-height: 1.4; overflow-wrap: anywhere; }
  @keyframes contact-dialog-in { from { opacity: 0; translate: 0 16px; } to { opacity: 1; translate: 0 0; } }
  @media (hover: hover) and (pointer: fine) {
    .contact-cta:hover { translate: 0 -3px; background: var(--color-surface-muted); }
    .contact-method:hover, .contact-close:hover { background: #343434; }
  }
  @media (max-width: 767px) {
    .contact-section { padding: 0; scroll-margin-top: 94px; }
    .contact-panel { min-height: 460px; padding: 56px 24px; gap: 24px; }
    .contact-action { margin-top: 96px; }
    .contact-intro { font-size: 15px; line-height: 1.5; }
    .contact-panel h2 { margin: 0; font-size: clamp(25px, 7.2vw, 34px); }
    .contact-cta { min-width: 190px; min-height: 56px; }
    .contact-dialog { inset: auto 0 0; width: 100%; max-height: calc(100dvh - 24px); margin: 0; padding: 20px 20px max(24px, env(safe-area-inset-bottom)); border-bottom: 0; border-radius: 0; }
    .contact-dialog[open] { animation-name: contact-sheet-in; }
    @keyframes contact-sheet-in { from { opacity: 0; translate: 0 100%; } to { opacity: 1; translate: 0 0; } }
  }
  @media (max-width: 479px) { .contact-form-row { grid-template-columns: 1fr; gap: 28px; } .contact-method { gap: 10px; padding: 12px; } .contact-method-detail { font-size: 11px; } .contact-method > svg { width: 20px; } .contact-method > span:last-child { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .contact-cta, .contact-cta:hover, .contact-cta:focus-visible { translate: none; transition: none; }
    .contact-method { transition: none; }
    .contact-dialog[open] { animation: none; }
    .contact-cta span { transform: none !important; transition: none; }
  }
</style>
